{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbz-platform/schemas/workflow.graph.v1.json",
  "title": "BBZ EPK workflow-template graph definition (v1)",
  "description": "MASTER_PROMPT §33, .ai/WORKFLOW_EPK.md. The `definition` jsonb of a workflow_template_versions row. Nodes are event / function / connector; edges connect node keys and may carry a rule-DSL `condition`. Publish-time validation (reachability, cardinality, …) is E05-06.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges", "start"],
  "properties": {
    "start": { "$ref": "#/$defs/nodeKey" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "nodeKey": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/nodeKey" },
        "type": { "enum": ["event", "function", "connector"] },
        "label": { "type": "string", "maxLength": 300 },
        "kind": {
          "enum": [
            "manual",
            "confirmation",
            "documentation",
            "integration_action",
            "notification",
            "timer",
            "event_update"
          ]
        },
        "connector": { "enum": ["and", "or", "xor"] },
        "direction": { "enum": ["split", "join"] },
        "props": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "function" } } },
          "then": { "required": ["kind"] }
        },
        {
          "if": { "properties": { "type": { "const": "connector" } } },
          "then": { "required": ["connector", "direction"] }
        },
        {
          "if": { "properties": { "type": { "const": "event" } } },
          "then": {
            "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["connector"] }] }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "from", "to"],
      "properties": {
        "key": { "$ref": "#/$defs/nodeKey" },
        "from": { "$ref": "#/$defs/nodeKey" },
        "to": { "$ref": "#/$defs/nodeKey" },
        "branch": { "type": "string", "maxLength": 64 },
        "condition": { "type": "object" }
      }
    }
  }
}
