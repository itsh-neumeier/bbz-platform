{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbz-platform/schemas/event.payloads.v1.json",
  "title": "BBZ event_type payload schemas (major version 1)",
  "description": "MASTER_PROMPT §3 / ADR-0011. One sub-schema per event_type under `properties`. Versioning policy: additive changes stay within v1; a breaking change ships a `.v2.json` file and a migration note in docs/domain/event-catalog.md. See docs/domain/event-catalog.md.",
  "type": "object",
  "properties": {
    "EVENT_CREATED": {
      "type": "object",
      "required": ["title", "priority", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "bbz_id": { "type": ["string", "null"] },
        "workplace_id": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "actor_id": {
          "type": ["string", "null"],
          "description": "null when the event was raised by the system (e.g. a trigger rule, E15-06), not a person"
        }
      }
    },
    "EVENT_ACCEPTED": { "$ref": "#/$defs/transition" },
    "EVENT_ACKNOWLEDGED": { "$ref": "#/$defs/transition" },
    "EVENT_OPENED": { "$ref": "#/$defs/transition" },
    "EVENT_ARCHIVED": {
      "allOf": [{ "$ref": "#/$defs/transition" }],
      "properties": { "reason": { "type": ["string", "null"] } }
    },
    "EVENT_REACTIVATED": {
      "type": "object",
      "required": ["from", "to", "actor_id", "reason"],
      "additionalProperties": true,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "actor_id": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "EVENT_ASSIGNED": {
      "type": "object",
      "required": ["to_user_id", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "from_user_id": { "type": ["string", "null"] },
        "to_user_id": { "type": "string" },
        "actor_id": { "type": "string" }
      }
    },
    "EVENT_TAKEN_OVER": {
      "type": "object",
      "required": ["from_user_id", "to_user_id", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "from_user_id": { "type": "string" },
        "to_user_id": { "type": "string" },
        "actor_id": { "type": "string" }
      }
    },
    "EVENT_UPDATED": {
      "type": "object",
      "required": ["changes", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "changes": { "type": "object", "minProperties": 1 },
        "actor_id": { "type": "string" }
      }
    },
    "EVENT_NOTE_ADDED": {
      "type": "object",
      "required": ["note_id", "kind", "body", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "note_id": { "type": "string" },
        "kind": { "enum": ["work", "postprocess"] },
        "body": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string" }
      }
    },
    "EVENT_NOTE_UPDATED": {
      "type": "object",
      "required": ["note_id", "thread_id", "version", "kind", "body", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "note_id": { "type": "string" },
        "thread_id": { "type": "string" },
        "supersedes_note_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 2 },
        "kind": { "enum": ["work", "postprocess"] },
        "body": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string" }
      }
    },
    "CALL_RINGING": { "$ref": "#/$defs/call_transition" },
    "CALL_ANSWERED": { "$ref": "#/$defs/call_transition" },
    "CALL_ENDED": { "$ref": "#/$defs/call_transition" },
    "LINE_IN_SERVICE": { "$ref": "#/$defs/line_state" },
    "LINE_OUT_OF_SERVICE": { "$ref": "#/$defs/line_state" },
    "CALL_DOCUMENTED": {
      "type": "object",
      "required": ["bbz_call_id", "category", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "bbz_call_id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "information_request",
            "technical_fault",
            "cleaning_report_customer",
            "evu_evi_notice",
            "other"
          ]
        },
        "has_free_text": { "type": "boolean" },
        "actor_id": { "type": "string" }
      }
    },
    "CONTACT_PRIORITY_CHANGED": {
      "type": "object",
      "required": ["contact_id", "from", "to", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "contact_id": { "type": "string", "minLength": 1 },
        "from": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
        "to": { "enum": ["low", "medium", "high"] },
        "actor_id": { "type": "string" }
      }
    },
    "CONTACT_CREATED": {
      "type": "object",
      "required": ["contact_id", "name", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "contact_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "org": { "type": ["string", "null"] },
        "quick_dial": { "type": "boolean" },
        "number_count": { "type": "integer", "minimum": 0 },
        "actor_id": { "type": "string" }
      }
    },
    "CONTACT_UPDATED": {
      "type": "object",
      "required": ["contact_id", "changes", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "contact_id": { "type": "string", "minLength": 1 },
        "changes": { "type": "object", "minProperties": 1 },
        "actor_id": { "type": "string" }
      }
    },
    "CONTACT_DELETED": {
      "type": "object",
      "required": ["contact_id", "name", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "contact_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "actor_id": { "type": "string" }
      }
    },
    "CLIENT_POPUP_RAISED": {
      "type": "object",
      "description": "A trigger show_client_popup action created a client_popup_events row (E15-14). Delivered to the bound workplace over the event stream; the payload carries no secrets.",
      "required": ["popup_id", "workplace_id", "kind", "expires_at"],
      "additionalProperties": true,
      "properties": {
        "popup_id": { "type": "string", "minLength": 1 },
        "workplace_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "actor_id": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "call_transition": {
      "type": "object",
      "required": ["bbz_call_id", "direction", "from", "to"],
      "additionalProperties": true,
      "properties": {
        "bbz_call_id": { "type": "string", "minLength": 1 },
        "source_call_id": { "type": ["string", "null"] },
        "direction": { "enum": ["inbound", "outbound"] },
        "line_id": { "type": ["string", "null"] },
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "line_state": {
      "type": "object",
      "required": ["provider", "external_id", "state"],
      "additionalProperties": true,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "external_id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["in_service", "out_of_service", "unknown"] }
      }
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "actor_id"],
      "additionalProperties": true,
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": "string" },
        "actor_id": { "type": "string" }
      }
    }
  }
}
