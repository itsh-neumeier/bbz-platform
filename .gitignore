# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
audit-requirements.txt

# --- Node / frontend ---
node_modules/
apps/web/dist/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/
# DB Type / DB Screen Sans is licensed per-organisation (DB Type
# Lizenzvereinbarung) and must not be redistributed via this public repo. Drop
# the woff2 files into apps/web/public/fonts/db-screen-sans/ on each build host;
# without them the UI uses the --db-font-family-sans fallback. See
# docs/frontend/db-ux-design.md.
apps/web/public/fonts/db-screen-sans/*.woff2
apps/web/public/fonts/db-screen-sans/*.woff
# DB logo — registered trademark, licensed asset, must not be redistributed here.
apps/web/public/brand/db-logo.svg
apps/bbz-kiosk/dist/
apps/bbz-kiosk/out/
apps/bbz-kiosk/test-results/
apps/bbz-kiosk/playwright-report/
*.tsbuildinfo

# --- Java / gateway ---
services/cucm-cti-gateway/target/
services/cucm-cti-gateway/build/
services/cucm-cti-gateway/libs/*.jar

# --- Go / Rust agents ---
agents/**/bin/
agents/**/target/
agents/**/*.exe

# --- Secrets / local config (NEVER commit) ---
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
*.secret
local.settings.*
# ...but deploy secret *templates* are tracked (the real files stay ignored):
!deploy/**/secrets/
deploy/**/secrets/*
!deploy/**/secrets/*.example
# generated etcd mTLS material — never committed
deploy/**/etcd/certs/

# --- IDE / OS ---
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- Build/infra artifacts ---
*.log
*.sbom.json
*.tar

# generated at CI time from deploy/security/scan-exceptions.toml (E23-07)
.trivyignore
