{
  "name": "@bbz/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BBZ / 3-S-Zentrale web UI (Vue 3 + PrimeVue).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0",
    "primevue": "4.5.4",
    "@primevue/themes": "4.5.4",
    "primeicons": "^7.0.0",
    "vue-i18n": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "globals": "^15.11.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.12.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
