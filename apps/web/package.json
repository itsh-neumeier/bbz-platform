    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
