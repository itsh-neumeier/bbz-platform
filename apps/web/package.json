{
  "name": "@bbz/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BBZ / 3-S-Zentrale web UI (Vue 3 + PrimeVue).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
