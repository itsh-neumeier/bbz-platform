# Copy to .env for local development. NEVER commit a real .env (see .gitignore).
# All backend settings use the BBZ_ prefix (see server/bbz_core/settings.py).

BBZ_ENVIRONMENT=local
BBZ_NODE_ID=BBZ-LOCAL
BBZ_LOG_LEVEL=INFO
BBZ_LOG_JSON=false

# Database (compose service name "postgres")
BBZ_DATABASE_URL=postgresql+asyncpg://bbz:bbz@postgres:5432/bbz

# Distributed config store (Phase 2 wires Patroni/etcd; Phase 0 only reports it)
BBZ_CLUSTER_DCS=etcd
BBZ_CLUSTER_DCS_ENDPOINTS=["http://etcd:2379"]

# Tracing (E22-01, ADR-0028). Spans are created by default; the OTLP exporter is
# off until a collector exists (E22-07). To ship traces:
#   BBZ_OTEL_TRACES_EXPORTER=otlp
#   BBZ_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# BBZ_OTEL_ENABLED=true
# BBZ_OTEL_TRACES_SAMPLER_RATIO=1.0

# Compose-only convenience values (not read by the app)
POSTGRES_USER=bbz
POSTGRES_PASSWORD=bbz
POSTGRES_DB=bbz
