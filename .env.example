# Copy to .env for local development. NEVER commit a real .env (see .gitignore).
# All backend settings use the BBZ_ prefix (see server/bbz_core/settings.py).

BBZ_ENVIRONMENT=local
BBZ_NODE_ID=BBZ-LOCAL
BBZ_LOG_LEVEL=INFO
BBZ_LOG_JSON=false
# Secret store (E23-01, ADR-0019). "env" = BBZ_<NAME> / $BBZ_SECRETS_DIR files.
# "vault" is the target but not wired yet. In staging/production the app refuses
# to start without a real jwt_secret and a DB password.
# BBZ_SECRET_PROVIDER=env
# BBZ_SECRETS_DIR=/run/secrets
# E22-03: per-module levels / noisy-event sampling / a file sink for a shipper
# BBZ_LOG_LEVELS=bbz_core.infra.leader=DEBUG,bbz_core.auth=WARNING
# BBZ_LOG_SAMPLE=heartbeat=0.01
# BBZ_LOG_FILE=/var/log/bbz/app.log

# Database (compose service name "postgres")
BBZ_DATABASE_URL=postgresql+asyncpg://bbz:bbz@postgres:5432/bbz

# CSRF (E23-05). CsrfMiddleware guards every cookie-auth write under /api/v1.
# A cross-origin SPA must be listed here (also used for CORS); same-origin needs
# nothing. Set BBZ_CSRF_ENABLED=false only as a temporary rollback.
# BBZ_CORS_ALLOW_ORIGINS=["https://bbz.example"]
# BBZ_CSRF_ENABLED=true

# Max request body (E23-06) — over this, writes get 413. 0 disables.
# BBZ_MAX_REQUEST_BODY_BYTES=1048576

# Audit-log hash chain (E23-09). The `audit-chain` worker seals + verifies the
# tamper-evident chain over audit_events; a break audits AUDIT_INTEGRITY_ALERT.
# BBZ_AUDIT_HASH_CHAIN_ENABLED=true
# BBZ_AUDIT_CHAIN_INTERVAL_SECONDS=300

# Distributed config store (Phase 2 wires Patroni/etcd; Phase 0 only reports it)
BBZ_CLUSTER_DCS=etcd
BBZ_CLUSTER_DCS_ENDPOINTS=["http://etcd:2379"]

# Tracing (E22-01, ADR-0028). Spans are created by default; the OTLP exporter is
# off until a collector exists (E22-07). To ship traces:
#   BBZ_OTEL_TRACES_EXPORTER=otlp
#   BBZ_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# BBZ_OTEL_ENABLED=true
# BBZ_OTEL_TRACES_SAMPLER_RATIO=1.0

# Compose-only convenience values (not read by the app)
POSTGRES_USER=bbz
POSTGRES_PASSWORD=bbz
POSTGRES_DB=bbz
# --profile monitoring (E22-07): Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin
