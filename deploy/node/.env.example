# deploy/node/.env — per-node configuration for ONE BBZ application server.
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# Secret *values* live in ./secrets/* (also gitignored), not here.

# --- node identity -------------------------------------------------------------
BBZ_NODE_ID=BBZ-SRV01
BBZ_ENVIRONMENT=production
BBZ_PUBLIC_NAME=bbz.example.internal

# --- container images (built by Epic 01 CI, pinned by digest in prod) ---------
BBZ_API_IMAGE=ghcr.io/itsh-neumeier/bbz-api:latest
BBZ_WEB_IMAGE=ghcr.io/itsh-neumeier/bbz-web:latest

# --- etcd member (this node) --------------------------------------------------
# For a one-node local simulation, point every entry at this host.
ETCD_ADVERTISE_HOST=127.0.0.1
ETCD_INITIAL_CLUSTER=BBZ-SRV01=http://127.0.0.1:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_CLUSTER_TOKEN=bbz-etcd
# Real 3-member cluster (SRV01,SRV02,QUORUM01 + mutual TLS) is wired in E06-03.

# --- PostgreSQL / Patroni ---------------------------------------------------
PATRONI_SCOPE=bbz
POSTGRES_ADVERTISE_HOST=127.0.0.1

# --- BBZ API ---------------------------------------------------------------
# The DSN carries the app DB password; the file is gitignored. Splitting the
# password into a Docker secret is a follow-up (needs a composed DSN).
BBZ_DATABASE_URL=postgresql+asyncpg://bbz:CHANGE_ME@127.0.0.1:5432/bbz
BBZ_CORS_ALLOW_ORIGINS=["https://bbz.example.internal"]
