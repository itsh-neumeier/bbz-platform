# deploy/node/.env — per-node configuration for ONE BBZ application server.
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# Secret *values* live in ./secrets/* ; etcd certs live in ./etcd/certs/ .

# --- node identity -------------------------------------------------------------
BBZ_NODE_ID=BBZ-SRV01
BBZ_ENVIRONMENT=production
BBZ_PUBLIC_NAME=bbz.example.internal

# --- container images (built by Epic 01 CI, pinned by digest in prod) ---------
BBZ_API_IMAGE=ghcr.io/itsh-neumeier/bbz-api:latest
BBZ_WEB_IMAGE=ghcr.io/itsh-neumeier/bbz-web:latest

# --- etcd: this member + the full 3-member cluster (ADR-0018) ----------------
# Every member lists all three; certs come from deploy/etcd/gen-certs.sh.
ETCD_ADVERTISE_HOST=bbz-srv01
ETCD_INITIAL_CLUSTER=BBZ-SRV01=https://bbz-srv01:2380,BBZ-SRV02=https://bbz-srv02:2380,BBZ-QUORUM01=https://bbz-quorum01:2380
ETCD_INITIAL_CLUSTER_STATE=new     # -> "existing" after the first successful boot
ETCD_CLUSTER_TOKEN=bbz-etcd

# --- PostgreSQL / Patroni ---------------------------------------------------
PATRONI_SCOPE=bbz
POSTGRES_ADVERTISE_HOST=bbz-srv01
# Patroni's etcd client targets — quoted host:port list
ETCD3_HOSTS='"bbz-srv01:2379","bbz-srv02:2379","bbz-quorum01:2379"'

# --- BBZ API ---------------------------------------------------------------
# The DSN carries the app DB password; the file is gitignored.
BBZ_DATABASE_URL=postgresql+asyncpg://bbz:CHANGE_ME@bbz-srv01:5432/bbz
BBZ_CLUSTER_DCS_ENDPOINTS=["https://bbz-srv01:2379","https://bbz-srv02:2379"]
BBZ_CORS_ALLOW_ORIGINS=["https://bbz.example.internal"]
# Patroni REST of both DB nodes -> /cluster/status role + lag
BBZ_PATRONI_REST_ENDPOINTS=["http://bbz-srv01:8008","http://bbz-srv02:8008"]

# --- tracing (E22-01, ADR-0028) ------------------------------------------
# Spans are always created (trace_id in logs); the OTLP exporter stays off
# until an OTel collector is deployed (E22-07). Then:
# BBZ_OTEL_TRACES_EXPORTER=otlp
# BBZ_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
