# deploy/node edge (roadmap E06-12). TLS termination, security-header baseline,
# api/web routing, WebSocket pass-through, health-based draining of a node that
# is not ready (E06-05). CSP fine-tuning for the web/Electron client is E23.
{
	admin off
	email ops@{$BBZ_PUBLIC_NAME}
}

(security_headers) {
	header {
		# HTTPS only, 1 year, include subdomains (add `preload` once submitted)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# baseline CSP — the web app tightens this in E23
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; connect-src 'self' wss:"
		-Server
		-X-Powered-By
	}
}

(api_upstream) {
	reverse_proxy api:8000 {
		# a node in rejoin/replay answers /health/ready with 503 (E06-05) →
		# Caddy marks the upstream down and stops routing to it (drain).
		health_uri /health/ready
		health_interval 3s
		health_timeout 3s
		health_status 2xx
		fail_duration 10s
		# streaming: no response buffering for SSE / WebSocket
		flush_interval -1
	}
}

{$BBZ_PUBLIC_NAME} {
	encode zstd gzip
	import security_headers

	# Internal PKI: mount the node's server cert + key and uncomment. Left out,
	# Caddy issues from its own local CA for the (non-public) internal hostname.
	# tls /etc/caddy/tls/server.crt /etc/caddy/tls/server.key

	# API, health, cluster status and the WebSocket stream (Caddy upgrades WS
	# transparently; flush_interval -1 keeps frames unbuffered)
	@api path /api/* /health/* /cluster/* /ws/*
	handle @api {
		import api_upstream
	}

	# SPA
	handle {
		reverse_proxy web:8080
	}
}

# plain HTTP → HTTPS
http://{$BBZ_PUBLIC_NAME} {
	redir https://{host}{uri} permanent
}
