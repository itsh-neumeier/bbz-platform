# deploy/node edge — TLS termination, security headers, routing.
# Full hardening (HSTS preload, CSP, rate limits — MASTER_PROMPT §22) is
# completed in E06-13 (#93). E06-01 only wires the proxy into the topology.

{
	admin off
	email ops@{$BBZ_PUBLIC_NAME}
}

{$BBZ_PUBLIC_NAME} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/* /health/* /cluster/* /ws/*
	handle @api {
		reverse_proxy api:8000 {
			# a node in rejoin/replay answers /health/ready with 503 (E06-05).
			# The client agent does server selection (E09-04); a load balancer
			# in front of the two nodes would use this as its active check.
			health_uri /health/ready
			health_interval 5s
			health_timeout 3s
		}
	}

	handle {
		reverse_proxy web:8080
	}
}
