# Dev-only edge for the repo-root docker-compose.yml (`--profile edge`). The
# production edge — TLS, HSTS/CSP baseline, /health/ready draining, WS
# pass-through — is deploy/node/reverse-proxy/Caddyfile (E06-12).
:8443 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	@api path /api/* /health/* /cluster/* /ws/*
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:5173
	}
}
