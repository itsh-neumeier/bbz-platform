# deploy/quorum/.env — BBZ-QUORUM01 (etcd witness only).
# Copy to .env and fill in. NEVER commit the real .env.
# Certs: copy ca.crt + BBZ-QUORUM01-{peer,server}.{crt,key} into ./etcd/certs/ .

BBZ_NODE_ID=BBZ-QUORUM01

ETCD_ADVERTISE_HOST=bbz-quorum01
ETCD_INITIAL_CLUSTER=BBZ-SRV01=https://bbz-srv01:2380,BBZ-SRV02=https://bbz-srv02:2380,BBZ-QUORUM01=https://bbz-quorum01:2380
ETCD_INITIAL_CLUSTER_STATE=new     # -> "existing" after the first successful boot
ETCD_CLUSTER_TOKEN=bbz-etcd

# bind the published ports to the host's internal management interface only
QUORUM_BIND=10.0.0.13
