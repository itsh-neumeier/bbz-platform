{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coda_video configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instance_id": { "type": "string", "default": "coda-mock-1" },
    "enabled_capability_groups": {
      "type": "array",
      "description": "Which capability groups this instance provides. Video and alarm ingress are independent — an instance may do only one.",
      "items": { "enum": ["video", "alarm_ingress"] },
      "uniqueItems": true,
      "default": ["video", "alarm_ingress"]
    },
    "simulated_sources": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_source_id", "name"],
        "properties": {
          "external_source_id": { "type": "string" },
          "name": { "type": "string" },
          "cameras": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      }
    },
    "camera_failures": {
      "type": "array",
      "description": "Camera refs whose open / focus operations fail — drives the camera side-effect failure path (E16-08 / E16-11).",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    }
  }
}
