{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dwd configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instance_id": { "type": "string", "default": "dwd-1" },
    "region": {
      "type": "string",
      "default": "mittelfranken",
      "description": "Operational target region — free text, used for labelling and the radar clip."
    },
    "enabled_capabilities": {
      "type": "array",
      "description": "Which weather capabilities this instance serves. Each is fed by its own DWD service (ADR-0026) and can be activated on its own.",
      "items": { "enum": ["weather.warnings", "weather.radar", "weather.observations"] },
      "uniqueItems": true,
      "default": ["weather.warnings", "weather.radar", "weather.observations"]
    },
    "places": {
      "type": "array",
      "description": "The places to report. If a place name is in the bundled DWD reference data (integrations/dwd/data/mittelfranken.json) its warncell ids + POI station are resolved automatically; `warncell_id`/`warncell_ids`/`poi_station_id` here override / extend that (e.g. for a place outside Mittelfranken).",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "warncell_id": {
            "type": "string",
            "description": "A single DWD DISTRICT warncell id (prefix 1). Merged with any resolved from the bundled data."
          },
          "warncell_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "DWD DISTRICT warncell ids covering this place (Stadt + Kreis)."
          },
          "poi_station_id": {
            "type": "string",
            "description": "DWD POI weather-report station id (E18-04)."
          }
        }
      }
    },
    "warnings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "default": "https://opendata.dwd.de/weather/alerts/cap/DISTRICT_DWD_STAT/"
        },
        "refresh_seconds": { "type": "integer", "minimum": 60, "default": 300 }
      },
      "default": {}
    },
    "radar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wms_url": {
          "type": "string",
          "format": "uri",
          "default": "https://maps.dwd.de/geoserver/dwd/wms"
        },
        "layer": { "type": "string", "default": "dwd:Niederschlagsradar" },
        "bbox": {
          "type": "array",
          "description": "minLon, minLat, maxLon, maxLat (WGS84) — the Mittelfranken clip.",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "default": [10.0, 48.9, 11.7, 49.8]
        },
        "frame_count": { "type": "integer", "minimum": 1, "maximum": 60, "default": 12 },
        "refresh_seconds": { "type": "integer", "minimum": 60, "default": 300 }
      },
      "default": {}
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "default": "https://opendata.dwd.de/weather/weather_reports/poi/"
        },
        "refresh_seconds": { "type": "integer", "minimum": 300, "default": 900 }
      },
      "default": {}
    }
  }
}
