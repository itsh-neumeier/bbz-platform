{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "monitor_mock configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instance_id": { "type": "string", "default": "mock" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["bbz-os", "bku1", "bku2", "bku3", "bku4", "coda1", "coda2"]
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "workplace1",
        "workplace2",
        "workplace3",
        "workplace4",
        "workplace5",
        "workplace6",
        "large-display"
      ]
    },
    "unreachable_outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Outputs that reject every route — simulates a hardware fault.",
      "default": []
    },
    "initial_routes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Seed routes (output_id -> input_id) the mock starts with.",
      "default": {}
    }
  }
}
