{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "telephony_sip configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["gateway"],
  "properties": {
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "host"],
      "description": "The SIP/CTI gateway this adapter drives.",
      "properties": {
        "kind": {
          "enum": ["asterisk_ari", "freeswitch_esl"],
          "description": "Chosen by ADR-0023 (E13-02)."
        },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": { "type": "boolean", "default": true }
      }
    },
    "credentials_secret_ref": {
      "type": "string",
      "description": "Reference into the secret store for the gateway API user/password (E13-07). Never inline credentials."
    },
    "lines": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Logical line / endpoint ids this instance owns."
    },
    "dtmf_transport": {
      "enum": ["rfc2833", "sip_info"],
      "default": "rfc2833",
      "description": "How send_dtmf delivers a configured profile (E13-06). The raw code stays in the secret store."
    }
  }
}
